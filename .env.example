# SQLite is used when no database URL is configured.
SOLARNEXUS_DATABASE_URL=sqlite:///./solarnexus.db
SOLARNEXUS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional in local development; required (32+ chars) when SOLARNEXUS_ENV=production.
SOLARNEXUS_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
SOLARNEXUS_ENV=development
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# PostgreSQL example:
# SOLARNEXUS_DATABASE_URL=postgresql+psycopg://solarnexus:solarnexus@localhost:5432/solarnexus
