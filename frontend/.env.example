# API base URL visible to the browser. Keep the same-origin path for the Vite proxy.
VITE_API_URL=/api/v1

# Server-side Vite proxy settings (NOT exposed to browser JavaScript).
SOLARNEXUS_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional service key; do not prefix it with VITE_.
SOLARNEXUS_API_KEY=
